# ---------------------------------------------------------------
# Variáveis do SERVIDOR da LP. Nenhuma é NEXT_PUBLIC_: o token do COMERCIAL
# nunca pode chegar ao navegador. Lidas em runtime (trocar = reiniciar).
# ---------------------------------------------------------------

# URL do COMERCIAL-RCO, sem barra no fim. Produção:
COMERCIAL_BASE_URL=https://comercial.rcoacademy.com.br

# Um token por página = uma integração por LP em COMERCIAL → Configurações →
# Integrações → Respondi (ícone de olho mostra a URL; o token é o final dela).
COMERCIAL_LEAD_TOKEN_P04=
COMERCIAL_LEAD_TOKEN_P05=
# /lp-ecom (integração "lp-ecom" no COMERCIAL). Sem ele os leads da /lp-ecom ficam pendentes na fila.
COMERCIAL_LEAD_TOKEN_ECOM=

# Onde a fila de leads (arquivos) fica. Em produção TEM que ser um volume
# persistente, senão um reinício do container apaga os leads pendentes.
# LEAD_OUTBOX_DIR=/data/outbox

# Origens extras aceitas em POST /api/lead, além do próprio host (vírgula).
# LEAD_ALLOWED_ORIGINS=

# Dias que o lead enviado fica no arquivo (tem nome e telefone). Padrão 30.
# OUTBOX_SENT_RETENTION_DAYS=30
